DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me"
STORAGE_ROOT="/srv/storage/vetadmin"

# Usuario admin creado por `npm run db:seed` (solo si no existe todavia)
SEED_ADMIN_EMAIL="admin@vetadmin.local"
SEED_ADMIN_PASSWORD="change-me"

# Mail del sistema (recuperacion de contraseña). Los defaults ya son los del
# VPS, asi que en produccion no hace falta setear nada: el mailer le habla al
# relay SMTP compartido por la red Docker mail_net. Ver vps/mail.md en
# infra-notes-vps-hostinger. El remitente TIENE que ser @mail.frodosoft.com.ar
# (unico dominio verificado en Mailgun).
# En desarrollo, apuntalos a un SMTP local para no mandar mail de verdad.
SYSTEM_MAIL_RELAY_HOST="mail"
SYSTEM_MAIL_RELAY_PORT=25
SYSTEM_MAIL_FROM="noreply@mail.frodosoft.com.ar"

# Recordatorios de turno por WhatsApp (Evolution API).
# Sin estas tres variables la app arranca igual y no manda nada; lo dice en el
# log al iniciar. El número desde el que sale el mensaje es el de la sesión de
# WhatsApp vinculada a la instancia, no se manda en cada pedido.
EVOLUTION_URL="http://evolution:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="vetadmin"

# A quién avisarle si la sesión de WhatsApp se cae (se cae en silencio: los
# recordatorios dejan de salir y nada lo dice). Si se deja vacío, se usa el email
# cargado en Configuración → Datos de la veterinaria; si tampoco hay, el aviso
# queda sólo en el log. Se avisa en la transición, no en cada pasada, y se
# insiste cada ALERTA_REPETIR_HORAS mientras siga caída.
ALERTA_WHATSAPP_EMAIL=""
ALERTA_REPETIR_HORAS=12

# Cuánto antes avisar y cada cuánto revisar (minutos). Son dos avisos: uno el
# día anterior y otro la hora previa. Las ventanas son bandas disjuntas (de 1440
# a 60 min, y de 60 a 0), así que un turno cargado media hora antes recibe un
# solo mensaje, no los dos de golpe.
RECORDATORIO_MINUTOS_ANTES=60
RECORDATORIO_MINUTOS_ANTES_DIA=1440
RECORDATORIO_INTERVALO_MINUTOS=5
