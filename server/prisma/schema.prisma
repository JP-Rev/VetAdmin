generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Modulos a los que entra este usuario, como JSON de strings (SQLite no
  // tiene arrays). El default da acceso a todo: los usuarios que ya existian
  // cuando se agrego la columna no pierden nada.
  permisos String @default("[\"general\",\"comercial\",\"usuarios\",\"clinica\"]")

  // Admin = puede escribir en el modulo Usuarios (crear, editar, borrar y
  // repartir permisos). El permiso `usuarios` a secas solo deja mirar la
  // lista. Default true por la misma razon que arriba: los usuarios que ya
  // existian cuando se agrego la columna son los que venian administrando.
  esAdmin Boolean @default(true)

  // Recuperacion de contraseña por mail. El token se guarda hasheado: el
  // valor crudo existe solo en el link que se manda por mail, nunca en la
  // base. Ambos campos se limpian al consumirlo.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
}

// Singleton: siempre la fila con id = "default".
model Clinica {
  id          String   @id @default("default")
  nombre      String   @default("Mi Veterinaria")
  direccion   String?
  telefono    String?
  email       String?

  // Número al que se invita a escribir en el recordatorio de turno. El WhatsApp
  // sale desde la sesión de Evolution, que es sólo para envíos automáticos y no
  // se lee: este es el número humano al que se deriva. Sin cargarlo, el mensaje
  // sale igual pero sin el enlace de contacto.
  whatsappContacto String?

  actualizado DateTime @updatedAt
}

model Cliente {
  id          String  @id @default(cuid())
  nombre      String
  telefono    String
  telefonoAlt String?
  email       String?

  // Domicilio en campos separados. Todos opcionales.
  calle     String?
  numero    String?
  localidad String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mascotas Mascota[]
  turnos   Turno[]
  ventas   Venta[]
}

model Raza {
  id        String   @id @default(cuid())
  nombre    String
  especie   String
  createdAt DateTime @default(now())

  mascotas Mascota[]
}

model Mascota {
  id              String   @id @default(cuid())
  nombre          String
  especie         String
  razaId          String?
  clienteId       String?
  fechaNacimiento DateTime
  sexo            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  raza    Raza?    @relation(fields: [razaId], references: [id], onDelete: SetNull)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  turnos              Turno[]
  ventas              Venta[]
  pesajes             Pesaje[]
  historialMedico     HistorialMedico[]
  mascotaEnfermedades MascotaEnfermedad[]
  mascotaCirugias     MascotaCirugia[]

  @@index([clienteId])
  @@index([razaId])
}

model CategoriaProducto {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productos Producto[]

  @@index([nombre])
}

model Producto {
  id          String   @id @default(cuid())
  nombre      String
  stock       Int      @default(0)
  precio      Float
  categoria   String
  categoriaId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoriaRef   CategoriaProducto? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  ventaProductos VentaProducto[]

  @@index([categoriaId])
}

model Enfermedad {
  id              String   @id @default(cuid())
  nombre          String
  descripcion     String
  especieAfectada String?
  createdAt       DateTime @default(now())

  mascotaEnfermedades MascotaEnfermedad[]
}

model Cirugia {
  id                  String   @id @default(cuid())
  tipo                String
  descripcion         String
  duracionEstimadaMin Int
  costoEstimado       Float
  createdAt           DateTime @default(now())

  mascotaCirugias MascotaCirugia[]
}

model Turno {
  id        String   @id @default(cuid())
  fecha     DateTime
  hora      String
  clienteId String?
  mascotaId String?
  motivo    String
  estado    String   @default("Pendiente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cuándo se mandó cada recordatorio por WhatsApp. Son dos avisos: uno el día
  // anterior y otro una hora antes. Cada uno tiene su marca propia, y es lo que
  // evita el doble envío: el planificador saltea el aviso que ya esté marcado.
  //
  // `recordatorioEnviadoAt` es el aviso de la hora previa. Conserva el nombre
  // viejo a propósito: cuando sólo había un recordatorio era éste, y renombrarlo
  // haría que `prisma db push` borre la columna y con ella las marcas, dejando
  // turnos ya avisados en condiciones de recibir el mensaje otra vez.
  recordatorioEnviadoAt          DateTime?
  recordatorioDiaAnteriorEnviadoAt DateTime?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mascota Mascota? @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([clienteId])
  @@index([mascotaId])
}

model Venta {
  id        String   @id @default(cuid())
  fecha     DateTime @default(now())
  clienteId String?
  mascotaId String?
  total     Float
  estado    String   @default("Pendiente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente   Cliente?        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mascota   Mascota?        @relation(fields: [mascotaId], references: [id], onDelete: SetNull)
  productos VentaProducto[]
  pagos     Pago[]

  @@index([clienteId])
  @@index([fecha])
}

model VentaProducto {
  id             String   @id @default(cuid())
  ventaId        String
  productoId     String
  cantidad       Int
  precioUnitario Float
  createdAt      DateTime @default(now())

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([ventaId])
}

model Pago {
  id        String   @id @default(cuid())
  ventaId   String
  monto     Float
  fecha     DateTime @default(now())
  metodo    String
  createdAt DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([ventaId])
}

model HistorialMedico {
  id           String   @id @default(cuid())
  mascotaId    String
  fecha        DateTime @default(now())
  tipoEvento   String
  descripcion  String
  referenciaId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mascota     Mascota      @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([mascotaId])
  @@index([fecha])
}

model Attachment {
  id           String   @id @default(cuid())
  historialId  String
  originalName String
  mimeType     String
  sizeBytes    Int
  storedPath   String
  createdAt    DateTime @default(now())

  historial HistorialMedico @relation(fields: [historialId], references: [id], onDelete: Cascade)

  @@index([historialId])
}

/// Un pesaje por visita. El "peso actual" es el mas reciente: guardarlo como
/// columna en Mascota se pisaba en cada edicion y no dejaba ver la evolucion,
/// que es justamente el dato clinico util.
model Pesaje {
  id        String   @id @default(cuid())
  mascotaId String
  fecha     DateTime
  peso      Float
  nota      String?
  createdAt DateTime @default(now())

  mascota Mascota @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([mascotaId, fecha])
}

model MascotaEnfermedad {
  id               String   @id @default(cuid())
  mascotaId        String
  enfermedadId     String
  fechaDiagnostico DateTime
  observaciones    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mascota    Mascota    @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  enfermedad Enfermedad @relation(fields: [enfermedadId], references: [id], onDelete: Cascade)

  @@index([mascotaId])
}

model MascotaCirugia {
  id            String   @id @default(cuid())
  mascotaId     String
  cirugiaId     String
  fecha         DateTime
  observaciones String?
  costoFinal    Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mascota Mascota @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  cirugia Cirugia @relation(fields: [cirugiaId], references: [id], onDelete: Cascade)

  @@index([mascotaId])
}

model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime
  descripcion String
  monto       Float
  categoria   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fecha])
}
