# Variables leidas por docker-compose.yml (copiar a .env junto al docker-compose.yml)

# Carpeta del host donde se guardan los archivos subidos (adjuntos del historial medico).
#
# En el VPS tiene que ser /srv/storage/vetadmin, sin excepcion: el backup
# automatico del servidor recorre /srv/storage/ para respaldar los archivos de
# todas las apps. Cualquier cosa guardada fuera de ahi NO se respalda.
# Ver vps/backups.md en el repo Infra-Notes-VPS-Hostinger.
#
# (El default anterior era "../storage/vet-admin", relativo, que en el VPS
# resolvia a /srv/docker/storage/vet-admin -- fuera del arbol de backup.)
STORAGE_ROOT_HOST=/srv/storage/vetadmin

# Puerto del cliente en el host. facturacion-web ya usa 3007 en este VPS, por
# eso vet-admin usa 3008. Se publica atado a 127.0.0.1 (ver docker-compose.yml):
# el trafico entra por el proxy del host, no por la IP publica del VPS.
CLIENT_PORT=3008

# La API no se publica al host: el cliente la alcanza por la red interna de
# Docker. Por eso no hay SERVER_PORT.
