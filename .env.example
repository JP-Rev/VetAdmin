# Variables leidas por docker-compose.yml (copiar a .env junto al docker-compose.yml)

# Carpeta del host donde se guardan los archivos subidos (adjuntos del historial medico).
# Por defecto, relativa a este archivo: si el repo esta en /srv/docker/vet-admin,
# resuelve a /srv/docker/storage/vet-admin. Se puede fijar una ruta absoluta distinta.
STORAGE_ROOT_HOST=../storage/vet-admin

# Puertos publicados en el host. facturacion-web ya usa 4000/3007 en este VPS,
# por eso vet-admin usa otros por defecto.
SERVER_PORT=4010
CLIENT_PORT=3008
